# Copy to .env and fill in
GEMINI_API_KEY=
# Free/Basic Gemini model (Flash-Lite). Examples: gemini-flash-lite-latest, gemini-3.5-flash-lite
GEMINI_MODEL=gemini-flash-lite-latest
# unclear_only | always | off — Gemini only when Laya can't decide (default unclear_only)
MARC_GEMINI_MODE=unclear_only
# Set true to use Gemini for mail summarize (slow on free tier)
MARC_MAIL_GEMINI=false
# Wait after each multi-step tool finishes before the next (seconds; keep low for speed)
MARC_STEP_GAP=0.7
# Skip spoken closers for open/close/hotkey/type/camera (much faster)
MARC_SILENT_RAPID=true
# Seconds before planner falls back offline (free tier can be slow)
GEMINI_TIMEOUT=45
# Optional: Maps Platform key (Places/Directions). Falls back to GEMINI_API_KEY.
GOOGLE_MAPS_API_KEY=
LAYA_MODEL_PATH=E:\laya-models
LAYA_MARC_INTENT_PATH=E:\laya-models\marc-intent
LAYA_CONFIDENCE_THRESHOLD=0.85
MARC_QUIET_MODE=false
MARC_PTT_HOTKEY=ctrl+shift+m
MARC_WHISPER_MODEL=base
MARC_WHISPER_DEVICE=cpu
# Label only — live TTS is Windows SAPI (not Edge Neural)
MARC_TTS_VOICE=en-US-GuyNeural
MARC_AUDIT_LOG=C:\Users\ranjith\mark-laptop\data\logs\audit.jsonl
MARC_USE_MULTILINGUAL=false
# Wake / mic (openWakeWord hey_jarvis)
MARC_WAKE_THRESHOLD=0.25
# PortAudio input index or substring of device name (leave empty for default)
MARC_AUDIO_DEVICE=
# Energy VAD for STT listen windows
MARC_VAD=true
MARC_VAD_SILENCE_MS=500
MARC_SPEECH_PEAK=0.012
# Heavy; leave false unless you have spare CPU
MARC_WHISPER_FALLBACK=false
