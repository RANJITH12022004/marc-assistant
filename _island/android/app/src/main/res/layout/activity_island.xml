<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="false">

    <FrameLayout
        android:id="@+id/island"
        android:layout_width="156dp"
        android:layout_height="30dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/island_bg"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/spoken"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical|end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="84dp"
            android:paddingEnd="14dp"
            android:text="Marc"
            android:textColor="#F5F5F7"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/confirm_card"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/confirm_summary"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/confirm_yes"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:text="@string/confirm_yes"
                android:textColor="#F5F5F7"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/confirm_no"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="12dp"
                android:text="@string/confirm_no"
                android:textColor="#8E8E93"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
