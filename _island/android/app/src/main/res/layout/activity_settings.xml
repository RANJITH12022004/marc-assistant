<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Models and modes for Marc on this phone."
            android:textColor="#99EBEBF5"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="API key"
            android:textColor="#99E8B15A"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/api_key"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="#FF121214"
            android:hint="Paste key"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#FFF5F5F7"
            android:textColorHint="#66EBEBF5"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/masked_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FF121214"
            android:padding="14dp"
            android:text="No key saved"
            android:textColor="#99EBEBF5"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/save_key"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="#22E8B15A"
            android:gravity="center"
            android:text="Save key"
            android:textColor="#FFE8B15A"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Models"
            android:textColor="#99E8B15A"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_spark"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="#22E8B15A"
                android:gravity="center"
                android:text="Spark"
                android:textColor="#FFE8B15A"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_wonder"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="#14FFFFFF"
                android:gravity="center"
                android:text="Wonder"
                android:textColor="#99EBEBF5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_voice"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="#14FFFFFF"
                android:gravity="center"
                android:text="Voice"
                android:textColor="#99EBEBF5"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/model_spark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FF121214"
            android:padding="12dp"
            android:text="muse-spark-1.3"
            android:textColor="#FFF5F5F7"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/model_wonder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#FF121214"
            android:padding="12dp"
            android:text="muse-wonder-1.0"
            android:textColor="#FFF5F5F7"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/model_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#FF121214"
            android:padding="12dp"
            android:text="muse-voice-transcribe-1.0"
            android:textColor="#FFF5F5F7"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Mode"
            android:textColor="#99E8B15A"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/marc_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FF121214"
            android:orientation="horizontal"
            android:padding="8dp">

            <RadioButton
                android:id="@+id/mode_sandbox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Sandbox"
                android:textColor="#FFF5F5F7" />

            <RadioButton
                android:id="@+id/mode_live"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Live"
                android:textColor="#FFF5F5F7" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#FF121214"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Driving mode"
                android:textColor="#FFF5F5F7"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/driving_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
